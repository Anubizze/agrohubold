# Production — скопируйте в .env на сервере и заполните значения
DEBUG=0
SECRET_KEY=change-me-to-random-secret
DJANGO_ALLOWED_HOSTS=agrohub.shakarim.kz
SITE_DOMAIN=https://agrohub.shakarim.kz
CSRF_TRUSTED_ORIGINS=https://agrohub.shakarim.kz

# MySQL
DB_ENGINE=django.db.backends.mysql
DB_NAME=agrohub_db
DB_USER=agrohub_user
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=3306

# Email (опционально)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@shakarim.kz
